# ── 运行时数据：数据库、头像、生成的知识图 ─────────────────────
# 里面是真实帖子与账号内容，绝不能进版本库
data/

# ── 依赖 ────────────────────────────────────────────────────
node_modules/

# ── 日志 ────────────────────────────────────────────────────
*.log

# ── 临时目录 ────────────────────────────────────────────────
.tmp*/

# ── 环境变量：里面是 API key，只保留示例文件 ─────────────────
.env
.env.*
!.env.example

# ── SQLite 的临时文件（万一被放到 data/ 之外） ────────────────
*.db
*.db-wal
*.db-shm

# ── 本机打包 / 发布产物 ─────────────────────────────────────
*.tgz
*.tar.gz

# ── 编辑器与系统 ────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
